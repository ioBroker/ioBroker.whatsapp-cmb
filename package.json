{
  "name": "iobroker.whatsapp-cmb",
  "version": "1.0.0",
  "description": "Allows to send to your whatsapp the messages from ioBroker",
  "author": {
    "name": "bluefox",
    "email": "dogafox@gmail.com"
  },
  "homepage": "https://github.com/ioBroker/ioBroker.whatsapp-cmb",
  "license": "MIT",
  "keywords": [
    "ioBroker",
    "whatsapp",
    "notifications"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ioBroker/ioBroker.whatsapp-cmb"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3",
    "axios": "^1.20.0"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^6.3.1",
    "@iobroker/types": "^7.2.5",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^22.20.5",
    "blockly": "^13.3.0",
    "esbuild": "^0.28.2",
    "typescript": "~6.0.3"
  },
  "main": "build/main.js",
  "files": [
    "build/",
    "admin/",
    "io-package.json",
    "LICENSE"
  ],
  "scripts": {
    "build:ts": "tsc -p tsconfig.build.json",
    "build:blockly": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tasks.ts",
    "blockly-0-check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tasks.ts --blockly-0-check",
    "blockly-1-bundle": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tasks.ts --blockly-1-bundle",
    "build": "npm run build:ts && npm run build:blockly",
    "watch": "tsc -p tsconfig.build.json --watch",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tasks.json && tsc -p src-blockly/tsconfig.json",
    "lint": "eslint -c eslint.config.mjs",
    "test:package": "mocha test/packageFiles --exit",
    "test:integration": "mocha test/integrationAdapter --exit",
    "test": "npm run test:package",
    "translate": "translate-adapter -b admin/i18n/en.json && translate-adapter -b src-blockly/i18n/en.json",
    "release": "release-script --noPush -y",
    "release-patch": "release-script patch --yes",
    "release-minor": "release-script minor --yes",
    "release-major": "release-script major --yes",
    "update-packages": "npx npm-check-updates --upgrade && cd src-blockly && npx npm-check-updates --upgrade",
    "npm": "npm i && cd src-blockly && npm i"
  },
  "bugs": {
    "url": "https://github.com/ioBroker/ioBroker.whatsapp-cmb/issues"
  },
  "readmeFilename": "README.md"
}
