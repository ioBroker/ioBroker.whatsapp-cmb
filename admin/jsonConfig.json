            "sm": 12,
            "md": 12,
            "lg": 12,
            "xl": 12
        },
        "_step2": {
            "type": "staticText",
            "text": "2. Send this message `I allow callmebot to send me messages` (in english) to the new Contact created (using WhatsApp of course)",
