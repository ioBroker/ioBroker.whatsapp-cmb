            "sm": 12,
            "md": 12,
            "lg": 12,
            "xl": 12
        },
        "_step1": {
            "type": "staticText",
            "text": "1. Add the phone number XXX (CallMeBot Website) into your Phone Contacts. (Name it as you wish)",
